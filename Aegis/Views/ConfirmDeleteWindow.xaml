<Window x:Class="Aegis.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Delete"
        Width="360"
        Height="180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0F0F0F">

    <Border Background="#0F0F0F"
            BorderBrush="#262626"
            BorderThickness="1"
            CornerRadius="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0"
                    Background="#0F0F0F"
                    BorderBrush="#262626"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseDown="TitleBar_MouseDown">

                <Grid Margin="14,0">
                    <TextBlock Text="Confirm Delete"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <Button Content="✕"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#161616"
                            Foreground="White"
                            Style="{StaticResource DarkButtonStyle}"
                            BorderBrush="#2A2A2A"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <StackPanel Grid.Row="1"
                        Margin="20">

                <TextBlock Text="Are you sure you want to delete this entry?"
                           FontSize="13"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Text="This action cannot be undone."
                           FontSize="11"
                           Foreground="#8A8A8A"
                           Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            Width="80"
                            Height="32"
                            Margin="0,0,10,0"
                            Background="#1C1C1C"
                            Foreground="White"
                            Style="{StaticResource DarkButtonStyle}"
                            BorderBrush="#2A2A2A"
                            Click="Cancel_Click"/>

                    <Button Content="Delete"
                            Width="80"
                            Height="32"
                            Background="#2A1E1E"
                            Foreground="#FF6B6B"
                            BorderBrush="#3A2A2A"
                            Style="{StaticResource DarkButtonStyle}"
                            Click="Confirm_Click"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
