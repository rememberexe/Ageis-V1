<Window x:Class="Aegis.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="500"
        Height="220"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0F0F0F">

    <Border Background="#0F0F0F"
            BorderBrush="#262626"
            BorderThickness="0"
            CornerRadius="16">

        <Grid>
            <Grid.RowDefinitions>
                <!-- TITLE BAR -->
                <RowDefinition Height="48"/>
                <!-- CONTENT -->
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Border Grid.Row="0"
                    Background="#0F0F0F"
                    BorderBrush="#262626"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseDown="TitleBar_MouseDown">

                <Grid Margin="12,0">
                    <TextBlock Text="Settings"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <!-- CLOSE BUTTON (NET VE BARİZ) -->
                    <Button Content="✕"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#1C1C1C"
                            Foreground="White"
                            BorderBrush="#2A2A2A"
                            Cursor="Hand"
                            Style="{StaticResource DarkButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <StackPanel Grid.Row="1"
                        Margin="20">

                <!-- SECURITY -->
                <Border Background="#161616"
                        BorderBrush="#262626"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,16">

                    <StackPanel>
                        <TextBlock Text="Security"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Auto-lock after inactivity"
                                   FontSize="12"
                                   Foreground="#7A7A7A"/>

                        <ComboBox x:Name="AutoLockCombo"
          Width="160"
          SelectionChanged="AutoLock_Changed">

                            <ComboBoxItem Content="5 minutes" Tag="5"/>
                            <ComboBoxItem Content="10 minutes" Tag="10"/>
                            <ComboBoxItem Content="30 minutes" Tag="30"/>
                        </ComboBox>


                        <CheckBox x:Name="ClipboardCheck"
          Content="Clear clipboard after copying password"
          Foreground="White"
          Checked="Clipboard_Checked"
          Unchecked="Clipboard_Unchecked"/>


                    </StackPanel>
                </Border>



            </StackPanel>
        </Grid>
    </Border>
</Window>
