<Window x:Class="Aegis.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aegis"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- TAMAMEN ŞEFFAF PENCERE -->
    <Grid>

        <!-- ORTA KART (TEK GÖRÜNEN ŞEY) -->
        <Border x:Name="LoginCard"
        Width="360"
        Padding="26"
        Background="#151515"
        BorderBrush="#262626"
        BorderThickness="1"
        CornerRadius="20"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        MouseDown="Card_MouseDown"
        Opacity="0">

            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate"
                        X="0"
                        Y="20"/>
            </Border.RenderTransform>




            <StackPanel>

                <!-- ÜST BAR (KART İÇİ) -->
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="AEGIS"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <Button Content="✕"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="#888888"
                            BorderThickness="0"
                            Style="{StaticResource DarkButtonStyle}"
                            FontSize="13"
                            Click="Close_Click"/>
                </Grid>

                <!-- AÇIKLAMA -->
                <TextBlock x:Name="ModeText"
                           Text="Enter Master Password"
                           Foreground="#AAAAAA"
                           FontSize="13"
                           Margin="0,0,0,20"/>

                <!-- LABEL -->
                <TextBlock Text="Master Password"
                           Foreground="#888888"
                           Margin="0,0,0,6"/>

                <!-- PASSWORD -->
                <Grid>
                    <PasswordBox x:Name="PasswordBox"
                                 Height="42"
                                 FontSize="14"
                                 Background="#1C1C1C"
                                 Foreground="White"
                                 BorderBrush="#2A2A2A"
                                 Padding="10"/>

                    <TextBox x:Name="PasswordText"
                             Height="42"
                             FontSize="14"
                             Background="#1C1C1C"
                             Foreground="White"
                             BorderBrush="#2A2A2A"
                             Padding="10"
                             Visibility="Collapsed"/>

                    <Button Content="👁"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Style="{StaticResource DarkButtonStyle}"
                            Background="Transparent"
                            Foreground="#AAAAAA"
                            BorderThickness="0"
                            Click="TogglePassword_Click"/>
                </Grid>

                <!-- ERROR -->
                <TextBlock x:Name="StatusText"
                           Foreground="#FF6B6B"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextAlignment="Center"
                           Visibility="Collapsed"/>

                <!-- ACTION -->
                <Button x:Name="ActionButton"
                        Content="Unlock"
                        Height="42"
                        Margin="0,22,0,0"
                        Background="#2A2A2A"
                        Foreground="White"
                        Style="{StaticResource DarkButtonStyle}"
                        BorderBrush="#3A3A3A"
                        Click="ActionButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
