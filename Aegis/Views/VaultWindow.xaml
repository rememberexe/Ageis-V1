<Window x:Class="Aegis.Views.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aegis.Converters"
        Title="Aegis Vault"
        Width="1120"
        Height="660"
        PreviewMouseDown="Window_UserActivity"
        PreviewKeyDown="Window_UserActivity"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0F0F0F">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources >
        
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="Transparent"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="#1E1E1E"/>
                                <Setter TargetName="Root"
                                Property="BorderBrush"
                                Value="#333333"/>
                            </Trigger>

                            <!-- PRESSED -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="#181818"/>
                                <Setter TargetName="Root"
                                Property="BorderBrush"
                                Value="#2A2A2A"/>
                            </Trigger>

                            <!-- DISABLED -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                Property="Opacity"
                                Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="Transparent"
                        CornerRadius="6">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="#222222"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                Property="Background"
                                Value="#181818"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:ImagePathToBitmapConverter x:Key="ImageConverter"/>

        <Style x:Key="IconPickerButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <local:NullToVisibilityConverter x:Key="NotNullToVisibility" Invert="True"/>

        <!-- Accent -->
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>

        <!-- Input Style -->
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Title Bar Button -->
        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid MouseDown="TitleBar_MouseDown">

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Width="280"
                Background="#121212"
                BorderBrush="#262626"
                BorderThickness="0,0,1,0"
                HorizontalAlignment="Left">
            <Border.RenderTransform>
                <TranslateTransform Y="20"/>
            </Border.RenderTransform>

            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                     To="0"
                                     Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- APP HEADER -->
                <StackPanel Margin="20,18,20,16">

                    <!-- APP NAME -->
                    <TextBlock Text="AEGIS"
               FontSize="24"
               FontWeight="SemiBold"
               Foreground="White"
               Margin="0,0,0,4" HorizontalAlignment="Center"/>

                    <!-- SUBTITLE -->
                    <TextBlock Text="Secure Vault"
               FontSize="11"
               Foreground="#7A7A7A"
               Margin="0,0,0,14" HorizontalAlignment="Center"/>

                    <!-- NEW ENTRY -->
                    <Button Content="+ New Entry"
            Height="36"
            Background="#2A2A2A"
            Foreground="White"
            BorderBrush="#3A3A3A"
                            Style="{StaticResource DarkButtonStyle}"
            Command="{Binding AddEntryCommand}"/>
                </StackPanel>


                <TextBox Grid.Row="1"
                         Margin="20,0,20,16"
                         Style="{StaticResource InputBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- ENTRY LIST -->
                <ListBox Grid.Row="2"
                         Margin="12,0,12,12"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch">

                    <!-- Card + Accent -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Background="#151515"
                                                CornerRadius="12"
                                                BorderBrush="#1F1F1F"
                                                BorderThickness="1"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Border x:Name="Accent"
                                                        Width="3"
                                                        Background="{StaticResource AccentBrush}"
                                                        HorizontalAlignment="Left"
                                                        Opacity="0"/>
                                                <ContentPresenter Margin="12"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#1A1A1A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#1C1C1C"/>
                                                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="#1C1C1C">
                                    <Grid>
                                        <Image Source="{Binding Image}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                RenderOptions.EdgeMode="Aliased"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding Image, Converter={StaticResource NotNullToVisibility}}"/>
                                        <TextBlock Text="🔐"
                                                   FontSize="16"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Image, Converter={StaticResource NullToVisibility}}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{Binding DisplayName, FallbackValue=New Entry}"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="White"/>

                                    <TextBlock Text="{Binding Username}"
                                               FontSize="11"
                                               Foreground="#8A8A8A"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>
        </Border>

        <!-- ================= RIGHT AREA ================= -->
        <Grid Margin="280,0,0,0">
            <TextBlock x:Name="AutoLockText"
Text="Auto-lock in 10:00"
FontSize="11"
Foreground="#7A7A7A"
HorizontalAlignment="Right"
Margin="0,40,20,0"/>

            <!-- TITLE BAR -->
            <Grid Height="42" VerticalAlignment="Top" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,6,12,0">
                    <Button Content="⚙" Style="{StaticResource TitleButtonStyle}" Click="Settings_Click"/>
                    <Button Content="🔒" Style="{StaticResource TitleButtonStyle}" Click="Lock_Click"/>
                    <Button Content="—" Style="{StaticResource TitleButtonStyle}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource TitleButtonStyle}" Click="Close_Click"/>
                    
                </StackPanel>
                
            </Grid>

            <!-- CONTENT -->
            <Border Margin="24,60,24,24"
                    Background="#151515"
                    BorderBrush="#262626"
                    BorderThickness="1"
                    CornerRadius="18">
               
                <Border.RenderTransform>
                    <TranslateTransform Y="20"/>
                </Border.RenderTransform>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                     To="0"
                                     Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0"
                  Focusable="False">
                <Grid>

                    <!-- EMPTY STATE -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="🔐" FontSize="36" Foreground="#3A3A3A" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select an entry"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,12,0,4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Choose a password from the list or create a new one."
                                   FontSize="12"
                                   Foreground="#7A7A7A"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- DETAIL -->
                    <StackPanel Margin="28"
                                Visibility="{Binding SelectedEntry, Converter={StaticResource NotNullToVisibility}}">

                        <!-- IMAGE -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal"
            Margin="0,0,0,20"
            Visibility="{Binding Image,
                         Converter={StaticResource NotNullToVisibility}}">

                                <!-- PREVIEW -->
                                <Border Width="72"
            Height="72"
            CornerRadius="12"
            Background="#1C1C1C"
            BorderBrush="#2A2A2A"
            BorderThickness="1">
                                        <Image
            Source="{Binding SelectedEntry.Image}"
                                            Stretch="UniformToFill"
RenderOptions.BitmapScalingMode="HighQuality"
SnapsToDevicePixels="True"/>

                                    </Border>

                                <!-- ICON PICKER -->
                                <StackPanel Orientation="Horizontal"
                Margin="12,18,0,0">

                                   

                                    <!-- CUSTOM IMAGE -->
                                    <Button Style="{StaticResource IconPickerButton}"
                Click="ChangeImage_Click"
                ToolTip="Upload custom image">
                                            <TextBlock Text="＋👤"
                       FontSize="18"
                       Foreground="#8A8A8A"/>
                                    </Button>

                                </StackPanel>
                            </StackPanel>


                        </StackPanel>
                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal"
             HorizontalAlignment="Right">
                                <Button Content="Delete"
             Width="90"
                                        Height="30"
             Background="#2A1E1E"
             Foreground="#FF6B6B"
             BorderBrush="#3A2A2A"
             Margin="0,0,10,0"
                                        Style="{StaticResource DarkButtonStyle}"
             Click="Delete_Click"/>
                                <Button Content="Save"
             Width="90"
             Style="{StaticResource DarkButtonStyle}"
             Command="{Binding SaveCommand}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Tag"
               FontSize="11"
               Foreground="#7A7A7A"
               Margin="0,0,0,4"/>

                            <TextBox Style="{StaticResource InputBoxStyle}"
             Text="{Binding SelectedEntry.DisplayName,
                            UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Username -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Username" FontSize="11" Foreground="#7A7A7A"/>
                            <TextBox Style="{StaticResource InputBoxStyle}"
                                     Text="{Binding SelectedEntry.Username}"/>
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Password" FontSize="11" Foreground="#7A7A7A"/>
                            <Grid>
                                <TextBox Style="{StaticResource InputBoxStyle}"
                                         Padding="10,0,36,0"
                                         Text="{Binding SelectedEntry.Password}"/>
                                <Button Content="👁"
                                        Width="28"
                                        Height="28"
                                        Foreground="White"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        Margin="0,5,6,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Notes" FontSize="11" Foreground="#7A7A7A"/>
                            <TextBox Height="120"
                                     AcceptsReturn="True"
                                     Style="{StaticResource InputBoxStyle}"
                                     Text="{Binding SelectedEntry.Notes}"/>
                        </StackPanel>
                        <!-- PAYMENT INFO -->
                        <StackPanel Margin="0,24,0,0">

                            <TextBlock Text="Payment Information"
               FontSize="13"
               FontWeight="SemiBold"
               Foreground="White"
               Margin="0,0,0,12"/>

                            <!-- Card Holder -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Card Holder Name"
                   FontSize="11"
                   Foreground="#7A7A7A"/>
                                <TextBox Style="{StaticResource InputBoxStyle}"
                 Text="{Binding SelectedEntry.CardHolderName}"/>
                            </StackPanel>

                            <!-- Card Number -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Card Number"
                   FontSize="11"
                   Foreground="#7A7A7A"/>
                                <TextBox Style="{StaticResource InputBoxStyle}"
                 Text="{Binding SelectedEntry.CardNumber}"/>
                            </StackPanel>

                            <!-- Expiry + CVV -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Width="120" Margin="0,0,12,0">
                                    <TextBlock Text="Expiry"
                       FontSize="11"
                       Foreground="#7A7A7A"/>
                                    <TextBox Style="{StaticResource InputBoxStyle}"
                     Text="{Binding SelectedEntry.ExpiryDate}"/>
                                </StackPanel>

                                <StackPanel Width="80">
                                    <TextBlock Text="CVV"
                       FontSize="11"
                       Foreground="#7A7A7A"/>
                                    <TextBox Style="{StaticResource InputBoxStyle}"
                     Text="{Binding SelectedEntry.CVV}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Bank -->
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Bank"
                   FontSize="11"
                   Foreground="#7A7A7A"/>
                                <TextBox Style="{StaticResource InputBoxStyle}"
                 Text="{Binding SelectedEntry.BankName}"/>
                            </StackPanel>

                        </StackPanel>

                       

                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
